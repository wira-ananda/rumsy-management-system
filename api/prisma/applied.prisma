// The activation marker is inserted only after a lossless offline migration.
model StorageMeta {
  id         Int    @id
  version    Int
  format     Int    @default(1)
  updatedAt  String
  sourceHash String
  writeToken String
  rootShape  Json

  @@map("rms_storage_meta")
}

// Configuration and unknown top-level extension fields; never a business snapshot.
model RootField {
  key   String @id
  value Json

  @@map("rms_root_fields")
}

// Local migration bookkeeping; Cloudflare cutover is a separate reviewed operation.
model SchemaMigration {
  name      String @id
  checksum  String
  appliedAt String

  @@map("rms_migration_history")
}
