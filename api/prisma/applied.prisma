/// @rms {"collection":"projects","kind":"array"}
model Project {
  storageKey          String            @id
  sortOrder           Int
  legacyShape         Json
  extra               Json
  id                  String?
  clientId            String?
  leadId              String?
  name                String?
  client              String?
  location            String?
  sales               String?
  salesUserId         String?
  ops                 String?
  opsUserId           String?
  qc                  String?
  qcUserId            String?
  status              String?
  startDate           String?
  targetFinish        String?
  actualFinish        String?
  progress            Float?
  originalContract    Float?
  started             Boolean?
  completionApproved  Boolean?
  rowsProjectContract ProjectContract[]
  rowsProjectHandover ProjectHandover[]
  rowsProjectPortal   ProjectPortal[]
  rowsPayment         Payment[]
  rowsInstallment     Installment[]
  rowsAddendum        Addendum[]
  rowsProjectDocument ProjectDocument[]
  rowsInspection      Inspection[]
  rowsQcFinding       QcFinding[]
  rowsDailyReport     DailyReport[]
  rowsWeeklyReport    WeeklyReport[]
  rowsProjectActivity ProjectActivity[]
  rowsProjectChat     ProjectChat[]

  @@index([sortOrder])
  @@index([clientId])
  @@index([leadId])
  @@index([status])
  @@index([salesUserId])
  @@index([opsUserId])
  @@map("rms_projects")
}

