  },
  "dependencies": {
    "@prisma/client": "7.8.0",
    "@prisma/adapter-d1": "7.8.0",
    "hono": "4.13.13"
  },
  "devDependencies": {
    "prisma": "7.8.0",
    "@prisma/internals": "7.8.0",
    "@cloudflare/workers-types": "5.20261016.1",
    "typescript": "6.0.3",
    "wrangler": "4.151.0"
  }
}
