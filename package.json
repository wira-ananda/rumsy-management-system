{
  "name": "rms-rumsy",
  "private": true,
  "type": "module",
  "workspaces": [
    "web",
    "api"
  ],
  "scripts": {
    "dev": "bun run --cwd web dev",
    "build": "bun run --cwd web build",
    "preview": "bun run --cwd web preview",
    "check": "bun run --cwd api check && bun run --cwd web check",
    "test": "bun run build:api && node --import ./tests/helpers/register-wasm.mjs --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "test:api": "bun run build:api && node --import ./tests/helpers/register-wasm.mjs tests/mock-api.mjs",
    "build:api": "bun run --cwd api build",
    "dev:api": "bun run --cwd api dev",
    "db:generate": "bun run --cwd api db:generate",
    "db:prepare": "bun run build:api && node scripts/database/prepare.mjs",
    "db:verify": "node --import ./tests/helpers/register-wasm.mjs scripts/database/verify-runtime.mjs",
    "db:studio": "node scripts/database/studio.mjs",
    "db:migration": "node scripts/database/create-migration.mjs",
    "dev:data": "bun run build:api && node --import ./tests/helpers/register-wasm.mjs scripts/database/serve-local.mjs",
    "db:apply-local": "node scripts/database/apply-local.mjs",
    "release:prepare": "bun run build && node scripts/package-release.mjs",
    "deploy:staging": "bun run check && bun run build && node scripts/deploy-pages.mjs staging",
    "deploy:production": "bun run check && bun run build && node scripts/deploy-pages.mjs production"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "acorn": "8.17.0",
    "eslint-scope": "9.1.2",
    "prettier": "3.9.5",
    "prettier-plugin-svelte": "4.1.1"
  }
}
